# ─── Server ───────────────────────────────────────────────────────────────────
# 3001 — aku-api owns 3000 on the same droplet
PORT=3001
NODE_ENV=production

# The public URL of this API server (used in email links + CORS)
API_URL=https://ugwo.nippysky.com

# The mobile app's deep-link scheme (must match app.config.js scheme)
APP_SCHEME=ugwo

# ─── Database ─────────────────────────────────────────────────────────────────
# Same PostgreSQL instance as Akù, SEPARATE database. Create once:
#   sudo -u postgres psql
#   CREATE USER ugwo_user WITH PASSWORD 'STRONG_PASSWORD';
#   CREATE DATABASE ugwo_db OWNER ugwo_user;
DATABASE_URL=postgresql://ugwo_user:STRONG_PASSWORD@localhost:5432/ugwo_db

# ─── Redis ────────────────────────────────────────────────────────────────────
# Same local Redis as aku-api — key prefixes don't collide.
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# 64+ random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_64_RANDOM_BYTES_BASE64

# Session lifetime (e.g. "30d", "7d", "24h")
JWT_EXPIRY=30d

# ─── DEK master key ───────────────────────────────────────────────────────────
# Encrypts users' Data Encryption Keys at rest. Generate ONCE with:
#   openssl rand -hex 32
# NEVER rotate casually — rotating orphans every stored DEK (clients will
# regenerate, but old ciphertext on new devices becomes unreadable).
SERVER_DEK_MASTER_KEY=REPLACE_WITH_64_CHAR_HEX

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# nippysky.com is already verified on Resend (Akù uses it).
# Create a separate API key for Ụgwọ at https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# The "from" address — must be on a verified Resend domain
EMAIL_FROM=Ụgwọ <auth@nippysky.com>

# Magic link tokens expire after this many minutes
MAGIC_LINK_EXPIRY_MINUTES=15

# ─── App-store review demo account (optional) ─────────────────────────────────
# Lets Apple/Google reviewers sign in without receiving email.
# Put the same values in the review notes. Leave unset to disable.
# DEMO_EMAIL=demo@nippysky.com
# DEMO_OTP=482913

# ─── Expo push (optional) ─────────────────────────────────────────────────────
# Only needed if "Enhanced push security" is enabled on the Expo project.
# EXPO_ACCESS_TOKEN=
